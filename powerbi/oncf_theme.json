{
  "name": "ONCF Orange & Bleu Ciel",
  "dataColors": [
    "#E85D04",
    "#00A8E8",
    "#0077B6",
    "#48CAE4",
    "#D00000",
    "#FAA307",
    "#023E8A",
    "#64748B"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#E85D04",
  "visualStyles": {
    "*": {
      "*": {
        "outspace": [{
          "color": { "solid": { "color": "#F8FAFC" } }
        }],
        "background": [{
          "color": { "solid": { "color": "#FFFFFF" } },
          "transparency": 0
        }],
        "border": [{
          "show": true,
          "color": { "solid": { "color": "#E2E8F0" } },
          "radius": 8
        }],
        "dropShadow": [{
          "show": true,
          "color": { "solid": { "color": "#CBD5E1" } },
          "position": "Outer",
          "preset": "BottomRight"
        }],
        "title": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 12,
          "fontColor": { "solid": { "color": "#0F172A" } },
          "alignment": "Left"
        }]
      }
    },
    "page": {
      "*": {
        "background": [{
          "color": { "solid": { "color": "#F8FAFC" } },
          "transparency": 0
        }]
      }
    }
  }
}
